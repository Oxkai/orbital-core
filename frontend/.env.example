# Privy app id, from the Privy dashboard (https://dashboard.privy.io).
#
# When set, sign-in goes through Privy: email, a social account, or an existing
# wallet, with an embedded wallet created for anyone who arrives without one.
# When unset, the app falls back to the injected-wallet connector and every
# page still works — no key is required to run or build it.
NEXT_PUBLIC_PRIVY_APP_ID=

# Optional: a private RPC URL (your own node / provider). Without this the app
# falls back to each chain's public endpoint, which is rate-limited and caps
# getLogs at a small block range.
NEXT_PUBLIC_RPC_URL=

# Optional: hosted Envio GraphQL endpoint for the Monad indexer. Without it the
# transactions feed falls back to scanning logs over RPC. See envio/README.md.
NEXT_PUBLIC_ENVIO_MONAD=
