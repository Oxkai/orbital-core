# Optional: a private Monad testnet RPC URL (your own node / provider).
# Without this the app falls back to the public endpoint (https://testnet-rpc.monad.xyz),
# which is rate-limited and caps getLogs at a small block range.
NEXT_PUBLIC_RPC_URL=https://testnet-rpc.monad.xyz

# Ponder indexer (see ../indexer). Defaults to http://localhost:42069 in dev.
NEXT_PUBLIC_INDEXER_URL=http://localhost:42069
